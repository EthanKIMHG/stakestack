# =============================================================================
# stakestack — environment variables
# -----------------------------------------------------------------------------
# Three runtimes read this file. Each variable is tagged with where it is used:
#   [web]     apps/web on Vercel (Next.js). Only NEXT_PUBLIC_* reach the browser.
#   [ingest]  packages/ingest, run by GitHub Actions cron (or locally).
#   [db]      scripts/db-migrate.sh / supabase CLI.
# Copy to .env (local) and set the same keys as Vercel env vars and GitHub
# Actions secrets. Never commit .env.
# =============================================================================

# ----------------------------------------------------------------- Supabase --
# Supabase now issues "publishable" (sb_publishable_...) and "secret" (sb_secret_...)
# API keys: Dashboard > Project Settings > API Keys. They are drop-in replacements
# for the legacy anon / service_role JWT keys (legacy tab exists until end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co            # [web][ingest]
# Publishable key: browser-safe, RLS applies. (legacy alias: NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx     # [web]
# Secret key: bypasses RLS, rejected from browsers. Ingest only. Create one named
# "stakestack-ingest" so it can be rotated alone. (legacy alias: SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx               # [ingest]
# SUPABASE_JWKS_URL (shown next to the keys) only verifies user JWTs issued by
# Supabase Auth. stakestack has no auth yet, so it is not needed.
# Direct Postgres URL for migrations (Dashboard > Database > Connection string,
# use the "session" pooler or direct 5432 port).
SUPABASE_DB_URL=
# Optional: supabase CLI project ref (for `supabase link` / `supabase db push`).
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx                                      # [db]

# ------------------------------------------------------------------- GitHub --
# Fine-grained personal access token. Required scope: NONE (public repos only).
# Set "Public repositories" access, no permissions. This raises the budget from
# 60 req/h (anonymous) to 5,000 GraphQL points/h + 5,000 REST req/h.
# A dedicated token per deployment is recommended so stakestack's usage never
# competes with other projects sharing the same account. See docs/GITHUB_API_SPEC.md.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # [ingest]
# Optional GitHub App auth instead of a PAT (higher 15,000/h budget for orgs).
# If GITHUB_APP_ID is set, GITHUB_TOKEN is ignored.
GITHUB_APP_ID=                                                                 # [ingest]
GITHUB_APP_INSTALLATION_ID=                                                    # [ingest]
GITHUB_APP_PRIVATE_KEY=                                                        # [ingest] PEM, \n-escaped

# -------------------------------------------------------- Ingest budgeting --
# Hard ceilings per ingest run. The run aborts (and reports) before exceeding
# them. Keep these low on purpose: the token may be shared with other projects.
INGEST_GRAPHQL_BUDGET_POINTS_PER_RUN=25        # [ingest] GraphQL rateLimit.cost allowed per run
INGEST_REST_BUDGET_REQUESTS_PER_RUN=120        # [ingest] REST calls allowed per run (304s are free and not counted)
INGEST_MIN_REMAINING_POINTS=1000               # [ingest] skip the run if the token's remaining GraphQL points are below this
INGEST_MIN_REMAINING_REST=1000                 # [ingest] same for REST core limit
# How many releases per repo to fetch on a normal poll (newest first). 5 covers
# late edits to release notes while keeping GraphQL node count low.
INGEST_RELEASES_PER_REPO=5                     # [ingest]
# First time a repo is seen (or when --backfill is passed), fetch this many.
INGEST_BACKFILL_RELEASES_PER_REPO=30           # [ingest]
# Repos per GraphQL request (aliases). 40 repos x (1 + 5 releases) ~= 240 nodes ~= 3 points.
INGEST_REPOS_PER_GRAPHQL_BATCH=40              # [ingest]
# Security advisories are polled over REST with ETags; only every N hours.
INGEST_ADVISORIES_INTERVAL_HOURS=24            # [ingest]
# Also poll git tags for repos that publish tags without GitHub Releases (catalog: release_source: tags).
INGEST_TAGS_PER_REPO=10                        # [ingest]
# Persist ETags / cursors between runs, relative to the repo root. GitHub Actions restores this dir via actions/cache.
INGEST_CACHE_DIR=packages/ingest/.cache        # [ingest]
# Write nothing to Supabase, just print what would change.
INGEST_DRY_RUN=false                           # [ingest]
# Log level: debug | info | warn | error
INGEST_LOG_LEVEL=info                          # [ingest]
# User-Agent sent to GitHub (GitHub requires one). Put a contact URL in it.
INGEST_USER_AGENT=stakestack-ingest/0.1 (+https://github.com/YOUR_ORG/stakestack)   # [ingest]

# ------------------------------------------------------------ Assessment --
# Rule-based assessment is always on. LLM assistance is optional (phase 2) and
# only runs for releases the rules left as "unassessed".
ASSESS_LLM_ENABLED=false                       # [ingest]
ANTHROPIC_API_KEY=                             # [ingest] only if ASSESS_LLM_ENABLED=true
ASSESS_LLM_MODEL=claude-sonnet-5-5             # [ingest]
ASSESS_LLM_MAX_RELEASES_PER_RUN=10             # [ingest] cost ceiling

# --------------------------------------------------- Upgrade / fork feeds --
# Comma-separated RSS/Atom feeds scanned for network-upgrade announcements
# (used to pre-fill network_upgrades for human confirmation, never auto-published).
UPGRADE_FEED_URLS=https://blog.ethereum.org/feed.xml   # [ingest]

# ---------------------------------------------------------------- Web app --
# Canonical public URL, used for RSS <link>, OpenGraph and share links.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app    # [web]
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/YOUR_ORG/stakestack   # [web]
# Secret for POST /api/revalidate (ingest calls it after writing new rows so
# ISR pages refresh immediately instead of waiting for the revalidate window).
REVALIDATE_SECRET=change-me-32-random-chars            # [web][ingest]
# ISR window in seconds for public pages when no revalidate call arrives.
NEXT_PUBLIC_ISR_SECONDS=300                            # [web]
# Enable anonymous stack sharing (insert into public.stacks with anon key).
NEXT_PUBLIC_ENABLE_ANON_STACKS=true                    # [web]

# ------------------------------------------------- Notifications (phase 2) --
RESEND_API_KEY=                                        # [ingest] email digests
NOTIFY_FROM_EMAIL=alerts@stakestack.example            # [ingest]
TELEGRAM_BOT_TOKEN=                                    # [ingest]
NOTIFY_WEBHOOK_SIGNING_SECRET=                         # [ingest] HMAC for outbound webhooks

# ------------------------------------------------------------ Observability --
SENTRY_DSN=                                            # [web][ingest] optional
