{
  "name": "stakestack",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source Ethereum staking stack builder and client release tracker: severity-rated releases and hard fork readiness for Sepolia, Hoodi and Mainnet, with DVT cluster support.",
  "homepage": "https://stakestack-eth.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kimhg2/stakestack.git"
  },
  "bugs": {
    "url": "https://github.com/kimhg2/stakestack/issues"
  },
  "keywords": [
    "ethereum",
    "staking",
    "validator",
    "node-operator",
    "consensus-client",
    "execution-client",
    "client-diversity",
    "hard-fork",
    "release-tracker",
    "dvt",
    "obol",
    "charon",
    "ssv",
    "mev-boost",
    "web3signer",
    "glamsterdam",
    "hoodi"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @stakestack/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "catalog:validate": "pnpm --filter @stakestack/shared catalog:validate",
    "catalog:sync": "pnpm --filter @stakestack/ingest sync-catalog",
    "ingest": "pnpm --filter @stakestack/ingest ingest",
    "ingest:dry": "pnpm --filter @stakestack/ingest ingest -- --dry-run",
    "reassess": "pnpm --filter @stakestack/ingest reassess",
    "db:migrate": "pnpm --filter @stakestack/ingest migrate",
    "db:migrate:psql": "bash scripts/db-migrate.sh"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
